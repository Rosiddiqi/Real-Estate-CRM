# ── KeyMatch server configuration (copy to server/.env) ──────────────────
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/estate_crm
PORT=3200
NODE_ENV=development
APP_URL=http://localhost:5173
APP_TIMEZONE=America/New_York

# Auth — use long random strings in production
JWT_SECRET=change-me
REFRESH_SECRET=change-me-too
ACCESS_TOKEN_TTL=30m
REFRESH_TOKEN_TTL_DAYS=60
# Local only: treat unauthenticated requests as the demo user. NEVER in production.
DEV_AUTH_BYPASS=0
# One-tap demo login button (demo@keymatch.app / keymatch). Set 0 once real clients are on the box.
DEMO_LOGIN_ENABLED=1
# Re-seed the demo book every night (4:20 AM APP_TIMEZONE) so its dates stay "today" — good for TestFlight.
DEMO_DAILY_RESET=0

# AI (Claude). Without a key every AI feature falls back to deterministic logic.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5
AI_DAILY_BUDGET_USD=10

# Messaging: demo (simulated) | twilio (real SMS) | bridge (paired Mac iMessage bridge)
MESSAGING_PROVIDER=demo
DEMO_AUTO_REPLIES=1
KILL_SWITCH=0

# Twilio (SMS + click-to-call). Optional.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
AGENT_CELL_NUMBER=

# Background jobs (battle plan pre-gen, matchmaker, campaigns, scheduled sends)
ENABLE_CRONS=1
