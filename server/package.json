{
  "name": "keymatch-server",
  "version": "0.1.0",
  "private": true,
  "description": "KeyMatch CRM API \u2014 Express + Prisma + Postgres + WebSocket hub",
  "main": "src/index.js",
  "scripts": {
    "start": "node src/index.js",
    "dev": "node --watch-path=src src/index.js",
    "db:push": "prisma db push",
    "db:generate": "prisma generate",
    "db:reset": "prisma db push --force-reset --skip-generate && node prisma/seed/index.js",
    "seed": "node prisma/seed/index.js",
    "test": "node --test \"src/**/*.test.js\"",
    "postinstall": "prisma generate"
  },
  "engines": {
    "node": ">=20"
  },
  "prisma": {
    "seed": "node prisma/seed/index.js"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.131.0",
    "@prisma/client": "^5.22.0",
    "bcryptjs": "^2.4.3",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "dotenv": "^16.6.1",
    "express": "^4.22.3",
    "jsonwebtoken": "^9.0.3",
    "multer": "^2.4.0",
    "node-cron": "^3.0.3",
    "twilio": "^5.13.1",
    "ws": "^8.22.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "prisma": "^5.22.0"
  }
}
