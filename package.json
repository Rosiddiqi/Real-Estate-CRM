{
  "name": "keymatch",
  "private": true,
  "version": "0.1.0",
  "description": "KeyMatch \u2014 the personal CRM for luxury real estate agents (RevMatch, re-geared for real estate).",
  "scripts": {
    "install:all": "npm --prefix server install && npm --prefix web install",
    "db:push": "npm --prefix server run db:push",
    "seed": "npm --prefix server run seed",
    "dev:api": "npm --prefix server run dev",
    "dev:web": "npm --prefix web run dev",
    "build": "npm --prefix web run build",
    "start": "NODE_ENV=production node server/src/index.js",
    "test": "npm --prefix server test",
    "ios:testflight": "bash scripts/ios/deploy-testflight.sh",
    "deploy:server": "bash scripts/server/deploy.sh"
  },
  "engines": {
    "node": ">=20"
  }
}
